-- Converte valor pra posição do slider
local MIN_VAL = 0.3
local MAX_VAL = 5.0

local function valToPos(val)
    return (val - MIN_VAL) / (MAX_VAL - MIN_VAL)
end

local function posToVal(pos)
    return MIN_VAL + (MAX_VAL - MIN_VAL) * pos
end

function setSlider(slider, val)
    val = math.clamp(val, MIN_VAL, MAX_VAL)
    local pos = valToPos(val)
    slider.value = val
    slider.fill.Size = UDim2.new(pos, 0, 1, 0)
    slider.knob.Position = UDim2.new(pos, -8, 0.5, -8)
    slider.label.Text = slider.name .. ": " .. string.format("%.2f", val) .. "x"
end

local function setupSliderDrag(slider, onChange)
    local dragging = false

    local function updateFromX(xPos)
        local trackAbsPos = slider.track.AbsolutePosition.X
        local trackAbsSize = slider.track.AbsoluteSize.X
        if trackAbsSize <= 0 then return end
        
        local relX = math.clamp((xPos - trackAbsPos) / trackAbsSize, 0, 1)
        local newVal = posToVal(relX)
        setSlider(slider, newVal)
        onChange()
    end

    local function startDrag(input)
        dragging = true
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end

    slider.knob.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            startDrag(input)
        end
    end)

    slider.track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            startDrag(input)
            updateFromX(input.Position.X)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            updateFromX(input.Position.X)
        end
    end)
end

-- Draggable da UI
local dragging, dragInput, dragStart, startPos

titleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = mainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)

titleBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X, 
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

-- Lógica de esticamento direto nas MeshParts
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")

-- Guarda os tamanhos originais
local originalSizes = {}
local originalPositions = {}

local function storeOriginals()
    for _, part in pairs(character:GetDescendants()) do
        if part:IsA("BasePart") or part:IsA("MeshPart") then
            originalSizes[part] = part.Size
            originalPositions[part] = part.CFrame
        end
    end
end

storeOriginals()

-- Mapeia quais partes pertencem a cada categoria
local partCategories = {
    head = {"Head"},
    torso = {"UpperTorso", "LowerTorso", "Torso"},
    arms = {"LeftUpperArm", "LeftLowerArm", "LeftHand", "RightUpperArm", "RightLowerArm", "RightHand", "Left Arm", "Right Arm"},
    legs = {"LeftUpperLeg", "LeftLowerLeg", "LeftFoot", "RightUpperLeg", "RightLowerLeg", "RightFoot", "Left Leg", "Right Leg"}
}

local function getPartCategory(partName)
    for cat, parts in pairs(partCategories) do
        for _, p in ipairs(parts) do
            if partName == p then return cat end
        end
    end
    return nil
end

local function applyStretch()
    local hScale = heightSlider.value
    local wScale = widthSlider.value
    local dScale = depthSlider.value
    local headScale = headSlider.value
    local armScale = armsSlider.value
    local legScale = legsSlider.value
    
    for _, part in pairs(character:GetDescendants()) do
        if (part:IsA("BasePart") or part:IsA("MeshPart")) and originalSizes[part] then
            local origSize = originalSizes[part]
            local category = getPartCategory(part.Name)
            
            local scaleY = hScale
            local scaleX = wScale
            local scaleZ = dScale
            
            -- Aplica escalas específicas por categoria
            if category == "head" then
                scaleY = headScale
                scaleX = headScale
                scaleZ = headScale
            elseif category == "arms" then
                scaleY = armScale
                scaleX = armScale
                scaleZ = armScale
            elseif category == "legs" then
                scaleY = legScale
                scaleX = legScale
                scaleZ = legScale
            end
            
            -- Modifica o Size da parte (isso replica pros outros jogadores)
            part.Size = Vector3.new(
                origSize.X * scaleX,
                origSize.Y * scaleY,
                origSize.Z * scaleZ
            )
        end
    end
    
    -- Ajusta as posições dos attachments pra não quebrar as juntas
    for _, joint in pairs(character:GetDescendants()) do
        if joint:IsA("Motor6D") or joint:IsA("JointInstance") then
            if joint.Part0 and joint.Part1 then
                -- Ajusta o C0 e C1 baseado nas escalas
                local p0Cat = getPartCategory(joint.Part0.Name)
                local p1Cat = getPartCategory(joint.Part1.Name)
                
                local scale0 = Vector3.new(wScale, hScale, dScale)
                local scale1 = Vector3.new(wScale, hScale, dScale)
                
                if p0Cat == "head" then scale0 = Vector3.new(headScale, headScale, headScale) end
                if p0Cat == "arms" then scale0 = Vector3.new(armScale, armScale, armScale) end
                if p0Cat == "legs" then scale0 = Vector3.new(legScale, legScale, legScale) end
                
                if p1Cat == "head" then scale1 = Vector3.new(headScale, headScale, headScale) end
                if p1Cat == "arms" then scale1 = Vector3.new(armScale, armScale, armScale) end
                if p1Cat == "legs" then scale1 = Vector3.new(legScale, legScale, legScale) end
                
                -- Escala as posições dos attachments
                local c0Pos = joint.C0.Position
                local c1Pos = joint.C1.Position
                
                joint.C0 = CFrame.new(
                    c0Pos.X * scale0.X,
                    c0Pos.Y * scale0.Y,
                    c0Pos.Z * scale0.Z
                ) * (joint.C0 - joint.C0.Position)
                
                joint.C1 = CFrame.new(
                    c1Pos.X * scale1.X,
                    c1Pos.Y * scale1.Y,
                    c1Pos.Z * scale1.Z
                ) * (joint.C1 - joint.C1.Position)
            end
        end
    end
end

local function applyNormal()
    for part, origSize in pairs(originalSizes) do
        if part and part.Parent then
            part.Size = origSize
        end
    end
    
    -- Reseta os joints
    for _, joint in pairs(character:GetDescendants()) do
        if joint:IsA("Motor6D") or joint:IsA("JointInstance") then
            if originalPositions[joint] then
                -- Não dá pra resetar C0/C1 facilmente, então só reseta as partes
            end
        end
    end
    
    setSlider(heightSlider, 1.0)
    setSlider(widthSlider, 1.0)
    setSlider(depthSlider, 1.0)
    setSlider(headSlider, 1.0)
    setSlider(armsSlider, 1.0)
    setSlider(legsSlider, 1.0)
end

